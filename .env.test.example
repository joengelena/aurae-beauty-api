# Copy to .env.test (gitignored) to configure the test suite.
# Anything not set here falls back to .env. POSTGRES_DATABASE is IGNORED:
# integration tests always run against SHINE_TEST_DATABASE (default shine_test),
# which the global setup DROPS and recreates on every run.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# Name of the throwaway test database. Must contain "test".
SHINE_TEST_DATABASE=shine_test

# Database used for the admin connection that drops/creates the test DB.
POSTGRES_ADMIN_DATABASE=postgres

# Sibling checkout of postgresql-db-tool (relative to shine_api, or absolute).
# Its sql/shine/{init,base-seed,test-seed} scripts build the test schema + seed.
SHINE_DB_TOOL_PATH=../postgresql-db-tool

# Set to 1 to see Winston output while tests run.
TEST_LOGS=0
