{
	"name": "shine-api",
	"version": "1.0.0",
	"description": "Shine Dress Rental API",
	"main": "dist/server.js",
	"scripts": {
		"prebuild": "tslint -c tslint.json -p tsconfig.json --fix",
		"build": "tsc",
		"prestart": "npm run build",
		"start": "node .",
		"test": "jest --runInBand",
		"dev": "nodemon",
		"test:unit": "jest --selectProjects unit",
		"test:integration": "jest --selectProjects integration --runInBand",
		"verify": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tslint -c tslint.json -p tsconfig.json && npm test"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.927.0",
		"@supabase/supabase-js": "^2.58.0",
		"@types/cookie-parser": "^1.4.7",
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"bcrypt": "^5.1.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.21.1",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.0.1",
		"pg": "^8.13.1",
		"uuid": "^11.0.3",
		"winston": "^3.15.0"
	},
	"devDependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/multer": "^1.4.12",
		"@types/node": "^22.10.7",
		"@types/pg": "^8.11.10",
		"@types/supertest": "^7.2.1",
		"jest": "^29.7.0",
		"nodemon": "^3.1.9",
		"supertest": "^7.3.1",
		"ts-jest": "^29.4.14",
		"ts-node": "^10.9.2",
		"tslint": "^6.1.3",
		"typescript": "^5.7.3"
	}
}
