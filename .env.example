# Server Configuration
PORT=4941
NODE_ENV=development

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=motorix_db

# Cloudflare R2 Configuration
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=motorix-images

# Optional: Custom domain for R2 bucket (if configured)
# Leave empty to use default R2 URL
R2_PUBLIC_DOMAIN=

# === SUPABASE CONFIGURATION ===
# Get these from your Supabase project dashboard at: https://app.supabase.com
# Project Settings > API

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Service role key (keep this secret! Only use on backend)
# This has admin privileges - never expose to client
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anon/public key (safe to use on frontend)
SUPABASE_ANON_KEY=your_anon_key_here

# Frontend URL for redirects after password reset
# This is where users will be redirected after clicking the reset link
FRONTEND_URL=http://localhost:3000

# Optional: Specific password reset redirect URL
# If not set, will use FRONTEND_URL/reset-password
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password